# ============================================================
# Drug Agent - 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ============================================================

# ==================== 数据库配置 ====================
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/drug_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root123

# ==================== AI 服务配置 ====================
# 通义千问 API Key (从阿里云百炼平台获取)
SPRING_AI_ALIBABA_API_KEY=your-api-key-here

# ==================== JWT 配置 ====================
# JWT 签名密钥 (至少32位)
JWT_SECRET=drug-agent-secret-key-2024-must-be-at-least-32-chars

# ==================== 服务器配置 ====================
SERVER_PORT=8080

# ==================== 文件上传配置 ====================
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=50MB

# ==================== 前端配置 ====================
VITE_API_BASE_URL=http://localhost:8080
