<?xml version="1.0" encoding="UTF-8"?>
<!--
  logback-spring.xml - Drug Agent 日志配置
  路径: src/main/resources/logback-spring.xml

  配置说明:
  - 控制台: 中文友好格式，易读性强
  - 文件: JSON 格式 + 中文级别 + 场景说明
  - 分类策略: tender_review/contract/risk 场景分文件
-->
<configuration>
    <!-- 彩色日志依赖的渲染类 -->
    <conversionRule conversionWord="clr" converterClass="org.springframework.boot.logging.logback.ColorConverter" />
    <conversionRule conversionWord="wex" converterClass="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter" />
    <conversionRule conversionWord="wEx" converterClass="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter" />

    <!-- ========== 属性定义 ========== -->

    <!-- 日志目录（doc/log 方便查看历史日志） -->
    <property name="LOG_PATH" value="doc/log"/>

    <!-- 控制台日志格式（中文友好） -->
    <!-- 格式：[时间] [级别] [追踪ID] [场景] [线程] [类名] 消息 -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{HH:mm:ss.SSS} %highlight(%-5level) [%magenta(%X{traceId:-无})] [%blue(%X{scene:-无})] %cyan([%thread]) %green(%-40.40logger{20}) - %m%n%wEx"/>

    <!-- ========== 控制台 Appender (彩色+中文) ========== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>utf8</charset>
        </encoder>
    </appender>

    <!-- ========== JSON 文件 Appender (通用) ========== -->
    <!-- 使用自定义 JSON 格式，增加中文可读性 -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/drug-agent.json</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/drug-agent.%d{yyyy-MM-dd}.json</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>scene</includeMdcKeyName>
            <includeMdcKeyName>sceneName</sceneName>
            <includeMdcKeyName>step</includeMdcKeyName>
            <includeMdcKeyName>stepName</includeMdcKeyName>
            <includeMdcKeyName>costMs</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>sessionId</includeMdcKeyName>
            <customFields>{"应用":"drug-agent","服务":"医药监管AI系统"}</customFields>
        </encoder>
    </appender>

    <!-- ========== 场景分类文件 Appender ========== -->

    <!-- 招标审查场景 -->
    <appender name="TENDER_REVIEW_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/tender-review.json</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/tender-review.%d{yyyy-MM-dd}.%i.json</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>scene</includeMdcKeyName>
            <includeMdcKeyName>sceneName</sceneName>
            <includeMdcKeyName>step</includeMdcKeyName>
            <includeMdcKeyName>stepName</includeMdcKeyName>
            <includeMdcKeyName>costMs</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>sessionId</includeMdcKeyName>
            <customFields>{"应用":"drug-agent","场景":"招标审查","场景英文":"TENDER_REVIEW"}</customFields>
        </encoder>
    </appender>

    <!-- 合同审查场景 -->
    <appender name="CONTRACT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/contract.json</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/contract.%d{yyyy-MM-dd}.%i.json</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>scene</includeMdcKeyName>
            <includeMdcKeyName>sceneName</sceneName>
            <includeMdcKeyName>step</includeMdcKeyName>
            <includeMdcKeyName>stepName</includeMdcKeyName>
            <includeMdcKeyName>costMs</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>sessionId</includeMdcKeyName>
            <customFields>{"应用":"drug-agent","场景":"合同审查","场景英文":"CONTRACT"}</customFields>
        </encoder>
    </appender>

    <!-- 风险预警场景 -->
    <appender name="RISK_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/risk.json</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/risk.%d{yyyy-MM-dd}.%i.json</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>scene</includeMdcKeyName>
            <includeMdcKeyName>sceneName</sceneName>
            <includeMdcKeyName>step</includeMdcKeyName>
            <includeMdcKeyName>stepName</includeMdcKeyName>
            <includeMdcKeyName>costMs</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>sessionId</includeMdcKeyName>
            <customFields>{"应用":"drug-agent","场景":"风险预警","场景英文":"RISK"}</customFields>
        </encoder>
    </appender>

    <!-- ========== 场景分类 Logger ========== -->

    <logger name="com.liang.drugagent.scene.tender_review" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="JSON_FILE"/>
        <appender-ref ref="TENDER_REVIEW_FILE"/>
    </logger>

    <logger name="com.liang.drugagent.scene.contract" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="JSON_FILE"/>
        <appender-ref ref="CONTRACT_FILE"/>
    </logger>

    <logger name="com.liang.drugagent.scene.risk" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="JSON_FILE"/>
        <appender-ref ref="RISK_FILE"/>
    </logger>

    <!-- ========== 框架日志级别调整 ========== -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="com.alibaba.nacos" level="WARN"/>
    <logger name="org.apache.catalina" level="WARN"/>
    <logger name="org.apache.coyote" level="WARN"/>
    <logger name="org.apache.tomcat" level="WARN"/>
    <logger name="com.baomidou.mybatisplus" level="WARN"/>

    <!-- 业务代码默认 DEBUG 级别 -->
    <logger name="com.liang.drugagent" level="DEBUG"/>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="JSON_FILE"/>
    </root>
</configuration>
