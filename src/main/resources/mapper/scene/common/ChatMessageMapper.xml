<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.liang.drugagent.agent.common.mapper.ChatMessageMapper">

    <select id="findByConversationIdOrderByCreatedAtDesc"
            resultType="com.liang.drugagent.agent.common.entity.ChatMessage">
        SELECT id,
               session_id,
               role,
               content,
               metadata,
               type,
               created_at
        FROM chat_message
        WHERE session_id = #{sessionId}
        ORDER BY created_at DESC
        LIMIT #{limit}
    </select>

    <delete id="deleteByConversationId">
        DELETE FROM chat_message
        WHERE session_id = #{sessionId}
    </delete>

</mapper>
